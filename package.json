{
  "name": "codebreak-tower-of-code",
  "private": true,
  "version": "1.2.0-rc.2",
  "type": "module",
  "description": "CodeBreak: The Tower of Code \u2014 browser-based learning adventure",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
